DATABASE_URL=postgres://episteme:change-me@localhost:5432/episteme?sslmode=disable
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
LISTEN_ADDR=127.0.0.1:8080
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
TEI_EMBED_URL=http://localhost:8081
TEI_RERANK_URL=http://localhost:8082
# Local generative model for editable metadata drafts. Does not replace TEI.
METADATA_ENABLED=true
METADATA_OLLAMA_URL=http://127.0.0.1:11434
METADATA_MODEL=gemma2:2b
OLLAMA_IMAGE=ollama/ollama:0.5.7
# Compose image; use cpu-arm64-1.9 on Apple Silicon / Linux ARM64.
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=knowledge_base
QDRANT_API_KEY=
QDRANT_TLS=false
# Generate locally, e.g. openssl rand -hex 32. Empty disables HTTP MCP.
MCP_TOKEN=
